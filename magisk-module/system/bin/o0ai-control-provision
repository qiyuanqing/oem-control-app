#!/system/bin/sh

PKG="com.o0ai.control"
ADMIN="${PKG}/.admin.ControlAdminReceiver"
BASE="/data/local/tmp/o0ai-control"
LOG="${BASE}/init-provision.log"

mkdir -p "${BASE}" 2>/dev/null
exec >>"${LOG}" 2>&1
echo "[$(date '+%F %T')] init provisioning started"

if dumpsys device_policy | grep -E "Device Owner:|Device Owner component" | grep -vq "null"; then
    echo "[$(date '+%F %T')] existing owner; skipping"
    exit 0
fi

attempt=0
while [ "${attempt}" -lt 120 ]; do
    if pm path "${PKG}" >/dev/null 2>&1; then
        if dpm set-device-owner "${ADMIN}"; then
            echo "[$(date '+%F %T')] owner provisioned"
            exit 0
        fi
    fi
    attempt=$((attempt + 1))
    sleep 1
done

echo "[$(date '+%F %T')] provisioning not permitted; setup may be complete"
exit 0
